# Base de données PostgreSQL
DATABASE_URL="postgresql://deplacements:deplacements@localhost:5432/deplacements"

# Serveur
PORT=5010
NODE_ENV=development
TZ=Africa/Casablanca
# URL publique du front (liens dans les e-mails, CORS)
APP_URL=http://localhost:5173

# Sécurité — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=a-remplacer-par-une-valeur-longue-et-aleatoire
JWT_EXPIRES_IN=8h
# Clé AES-256 (64 caractères hexadécimaux) pour le chiffrement au repos (CIN, RIB, justificatifs)
ENCRYPTION_KEY=a-remplacer-par-64-caracteres-hexadecimaux

# Stockage des justificatifs et sauvegardes
UPLOAD_DIR=./storage/justificatifs
BACKUP_DIR=./storage/sauvegardes
BACKUP_RETENTION=30
UPLOAD_MAX_MB=10

# E-mails (sans SMTP_HOST, les e-mails sont journalisés sans être envoyés)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chambre d'Artisanat Souss Massa <no-reply@ca-soussmassa.ma>"

# Tâches planifiées (rappels, passage EN_COURS, sauvegardes)
CRON_ENABLED=true
