# Port de l'API
PORT=4100

# Fichier SQLite (créé au premier lancement)
DB_PATH=data/tenders.db

# Origines autorisées à appeler l'API depuis un navigateur (« * » pour toutes)
CORS_ORIGINS=*

# Contact envoyé au portail dans l'en-tête User-Agent : obligatoire pour collecter.
# L'administrateur du portail doit pouvoir joindre l'exploitant du collecteur.
COLLECT_CONTACT=

# Collecte quotidienne automatique (heure de Casablanca, vide = désactivée)
COLLECT_AT=02:30

# Plage horaire autorisée (heure de Casablanca). Hors plage, seul « --force » lance
# un essai réduit (1 page, 10 fiches).
COLLECT_WINDOW=00:00-07:00

# Notifications push (Firebase Cloud Messaging) : chemin du fichier JSON du compte de
# service (console Firebase > Paramètres du projet > Comptes de service > Générer une
# nouvelle clé privée). Vide = aucune notification envoyée. Ne jamais versionner ce fichier.
FCM_SERVICE_ACCOUNT=
# Heure de la tournée quotidienne de notifications (Casablanca)
NOTIFY_AT=08:30

# Politesse envers le portail
PMMP_DELAY_MS=3000        # pause entre deux requêtes, 2000 au minimum
PMMP_TIMEOUT_MS=30000     # délai maximal d'une requête
PMMP_MAX_ERRORS=3         # erreurs serveur d'affilée avant arrêt

# Volume
PMMP_PAGE_SIZE=100        # 10, 20, 50, 100 ou 500
PMMP_MAX_PAGES=80
PMMP_DETAILS_PER_RUN=400

# Adresses du portail (à ne changer que si le portail déménage)
PMMP_BASE_URL=https://www.marchespublics.gov.ma/
PMMP_SEARCH_PATH=index.php?page=entreprise.EntrepriseAdvancedSearch&AllCons
